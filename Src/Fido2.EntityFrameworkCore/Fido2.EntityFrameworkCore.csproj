<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Fido2NetLib.EntityFrameworkCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <Description>An EF Core-backed ICredentialStore implementation for fido2-net-lib.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built against the EF Core major that matches each target: EF Core 10's ExecuteUpdate setters are not
         binary compatible with EF Core 9's, so one build cannot serve both. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Condition="'$(TargetFramework)' != 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fido2.Models\Fido2.Models.csproj" />
  </ItemGroup>

</Project>
