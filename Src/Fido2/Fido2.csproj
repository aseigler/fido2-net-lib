<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Fido2NetLib</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <NoWarn>$(NoWarn);IDE0057</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    Set DisableNSec=true to build without NSec.Cryptography, for consumers whose policy forbids the
    dependency. EdDSA (COSE -8 and -19) then reports UnimplementedAlgorithm the way Ed448 already does;
    every other algorithm is unaffected. See Documentation/building-without-nsec.md.
  -->
  <PropertyGroup Condition="'$(DisableNSec)' == 'true'">
    <DefineConstants>$(DefineConstants);FIDO2_DISABLE_NSEC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fido2.Models\Fido2.Models.csproj" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NSec.Cryptography" Condition="'$(DisableNSec)' != 'true'" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <!--
    Bundle Fido2.Analyzers into this package instead of shipping it separately, so every consumer of Fido2 gets
    FIDO001/FIDO002 automatically. OutputItemType="Analyzer" also makes the rules apply live while building
    this solution itself (see Tests/Fido2.Analyzers.Tests for the rules' own tests); ReferenceOutputAssembly is
    false because consumers must never get an assembly reference to the analyzer, only the analyzer itself.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Fido2.Analyzers\Fido2.Analyzers.csproj"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer"
                       SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fido2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The name of the file must equal to the name of the package which is currently
      defaulting to the project file name (excluding file extension of course).
    -->
    <Content Include="build/fido2.targets" PackagePath="build/" />
  </ItemGroup>

  <!-- Packs Fido2.Analyzers' build output into this package's analyzers/dotnet/cs, the standard NuGet
       analyzer path: this is what makes the bundled analyzer actually load in consumers' IDEs/builds, not
       just this solution's. Depends on the ProjectReference above having already built it. -->
  <Target Name="IncludeFido2AnalyzersInPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\Fido2.Analyzers\bin\$(Configuration)\netstandard2.0\Fido2.Analyzers.dll"
            Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
