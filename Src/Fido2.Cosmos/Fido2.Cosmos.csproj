<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Fido2NetLib.Cosmos</RootNamespace>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <Description>An Azure Cosmos DB-backed ICredentialStore implementation for fido2-net-lib, using the native Microsoft.Azure.Cosmos SDK.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <!-- For IServiceCollection in the DI extension. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Microsoft.Azure.Cosmos already depends on this transitively, but the store's own POCOs use
         Newtonsoft.Json attributes directly (to match the Cosmos SDK's default serializer), so it is
         referenced explicitly. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fido2.Models\Fido2.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fido2.Cosmos.Tests" />
    <!-- Moq mocks Container/FeedIterator<CosmosItem>/ItemResponse<CosmosItem> for CosmosCredentialStoreMockTests;
         since CosmosItem is internal and Microsoft.Azure.Cosmos.Client is strong-named, Castle's dynamic proxy
         generator (Moq's proxy engine) needs its own grant, separate from the one above, to construct a proxy
         over a type parameterized with CosmosItem. This is Castle/Moq's own well-known public key. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
  </ItemGroup>

</Project>
